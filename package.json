{
  "name": "madras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8173",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check": "wrangler types && tsc --noEmit && node --check public/app.js",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
