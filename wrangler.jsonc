{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "madras",
  "main": "src/worker.ts",
  "account_id": "e90f984eb1ade431d5470193871f6165",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madras-db",
      "database_id": "1cc62f21-352d-4ec1-a88b-4b2b80218c3e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
